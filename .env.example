APP_NAME="Answer Platform API"
# Allowed values: development, test, production.
ENVIRONMENT=development
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=answer_platform_dev
JWT_SECRET=change-me-before-production
JWT_ALGORITHM=HS256
# Valid range: 1-43200 minutes. Use a randomly generated secret in production.
JWT_EXPIRE_MINUTES=1440
# JSON array of explicit HTTP(S) origins; wildcards and URL paths are rejected.
CORS_ORIGINS='["http://localhost:5173","https://localhost:5173"]'
# Development only. This flag is rejected in test and production.
ENABLE_DEV_DEFAULT_ADMIN=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
AI_PROVIDER=placeholder
# Whole submission timeout; lease must be longer than timeout.
AI_JOB_TIMEOUT_SECONDS=60
AI_LEASE_SECONDS=90
AI_POLL_SECONDS=2
# Per-cycle budget includes the first execution and crash recovery.
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_SECONDS=5
